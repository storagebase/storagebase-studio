[Unit]
Description=StorageBase Studio
After=docker.service network-online.target storagebase-firstboot.service
# Wants=, not Requires=/BindsTo=: a docker daemon restart must not leave the app
# down permanently - the container dies and Restart= brings it back.
Wants=network-online.target docker.service
# Credentials must exist before the app starts. The ordering above resolves
# inside the boot transaction - safe precisely BECAUSE storagebase-firstboot never
# starts this unit itself. The condition makes the unit skip (not fail) on a
# boot where the env file is missing, which is why it can be enabled at build
# time.
ConditionPathExists=/etc/storagebase-studio.env

[Service]
ExecStartPre=-/usr/bin/docker rm -f storagebase-studio
ExecStart=/usr/bin/docker run \
  --name storagebase-studio \
  --init \
  -p 3000:3000 \
  --env-file /etc/storagebase-studio.env \
  -v /opt/storagebase/data:/app/data \
  PINNED_IMAGE
ExecStop=/usr/bin/docker stop storagebase-studio
ExecStopPost=-/usr/bin/docker rm -f storagebase-studio
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
