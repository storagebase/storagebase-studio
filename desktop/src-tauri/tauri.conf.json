{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storagebase-studio-desktop",
  "version": "../../package.json",
  "identifier": "org.storagebase.Studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StorageBase Studio",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "The open-source SQL IDE for cloud-native teams",
    "longDescription": "StorageBase Studio is an open-source SQL IDE for PostgreSQL, MySQL, SQLite, libSQL, DuckDB, Oracle, SQL Server, MongoDB, Redis, Couchbase, ClickHouse, Apache Druid, Elasticsearch, OpenSearch, Apache Trino and Apache Cassandra, with AI query assistance. The desktop build runs the same server StorageBase Studio ships everywhere else as a local sidecar and keeps all data on this machine.",
    "homepage": "https://storagebase.org",
    "publisher": "StorageBase",
    "license": "MIT",
    "copyright": "Copyright (c) StorageBase",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["bin/storagebase-studio-node"],
    "resources": ["payload"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "desktop-entry.hbs"
      }
    }
  }
}
