{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/exports/index.js",
    "src/components/ui/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@workflow/world-postgres",
    "@ai-sdk/anthropic",
    "@aws-sdk/client-sqs",
    "@aws-sdk/client-kms",
    "@aws-sdk/client-secrets-manager",
    "@azure/keyvault-secrets",
    "kafkajs",
    "amqplib",
    "@types/amqplib"
  ],
  "ignoreBinaries": [
    "genhtml",
    "gh"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": [
    "-lintignore"
  ]
}
